<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Terraform sandbox</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 4rem auto; padding: 0 1rem; line-height: 1.5; }
    code { background: #eee; padding: 0.1rem 0.3rem; border-radius: 4px; }
  </style>
</head>
<body>
  <h1>Hello from Terraform - Just a junk site for a slow learner! 👋</h1>
  <p>This page was deployed by GitHub Actions running <code>terraform apply</code>.</p>
  <ul>
    <li>Resource group: <code>${resource_group}</code></li>
    <li>Region: <code>${location}</code></li>
    <li>Storage account: <code>${storage_account}</code></li>
  </ul>
</body>
</html>
